    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
