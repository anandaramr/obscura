{
  "name": "@anandaramr/obscura",
  "version": "1.1.1",
  "description": "A lightweight local media streaming server",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/anandaramr/obscura.git"
  },
  "bin": {
