{
  "name": "@anandaramr/obscura",
  "version": "1.0.0",
  "description": "A lightweight local media streaming server",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "obscura": "dist/server.js"
  },
  "files": [
    "dist/**/*",
    "public/**/*"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "morgan": "^1.10.1",
    "p-limit": "^7.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
